#!/usr/bin/php
<?php
define('GIT_DEPLOY_DIR', __DIR__ . '/.gitdeploy');
define('VENDOR_DIR', __DIR__ . '/vendor');
ini_set('max_execution_time', 0);

require_once VENDOR_DIR . '/autoload.php';

use phpseclib3\Crypt\PublicKeyLoader;
use phpseclib3\Net\SFTP;

$opts = getopt("lr:", ["revert", 'rollback', 'env:', 'maintenance']);
$list = isset($opts['l']);
// --maintenance serves web/.maintenance.php (503) from the upload until the after hooks finish, whatever the .ini says
$forceMaintenance = isset($opts['maintenance']);
$revision = isset($opts['r']) ? $opts['r'] : 'HEAD';
$revert = isset($opts['revert']);
// --rollback restores the files the last staged deploy overwrote or deleted (stagedDeploy only)
$rollback = isset($opts['rollback']);
$deploy = isset($opts['env']) ? $opts['env'] : 'deploy.ini';
$deploy = GIT_DEPLOY_DIR . '/' . $deploy;
if (substr($deploy, -4) !== '.ini') {
	$deploy .= '.ini';
}

/**
 * Get local path to file containing revision deployed to server.
 * @global string $deploy
 * @return string
 */
function getRemoteRevisionLocalFilepath(): string
{
	global $deploy;
	return GIT_DEPLOY_DIR . '/REMOTE_REVISION-' . basename($deploy, '.ini');
}


/**
 * Add all filepaths from $relPath to $arr
 * @param string $relPath
 * @param array $arr Array to put file list to
 */
function addFilesFromDirectory(string $relPath, array &$arr): void
{
	$absPath = __DIR__ . '/' . $relPath;
	foreach (get_recursive_file_list($absPath, $relPath) as $f) {
		$arr[$f] = $f;
	}
}


function get_recursive_file_list(string $folder, string $prefix = ''): array
{

	# Add trailing slash
	$folder = (substr($folder, strlen($folder) - 1, 1) == '/') ? $folder : $folder . '/';

	$return = [];

	foreach (clean_scandir($folder) as $file) {
		if (is_dir($folder . $file)) {
			$return = array_merge($return, get_recursive_file_list($folder . $file, $prefix . $file . '/'));
		} else {
			$return[] = $prefix . $file;
		}
	}

	return $return;
}


function clean_scandir(string $folder, array $ignore = []): array
{
	$ignore[] = '.';
	$ignore[] = '..';
	$ignore[] = '.DS_Store';
	$return = [];

	foreach (scandir($folder) as $file) {
		if (!in_array($file, $ignore)) {
			$return[] = $file;
		}
	}

	return $return;
}


try {
	$git = new Terra_Git();
	if (!$list) {
		$git->setDeployFile($deploy);
		if ($rollback) {
			$git->rollback();
		} elseif ($revert) {
			$git->revert();
		} else {
			$git->deploy($revision);
		}
	} else {
		$remoteRevisionLocalFilePath = getRemoteRevisionLocalFilepath();
		if (file_exists($remoteRevisionLocalFilePath)) {
			$remoteRevision = trim(file_get_contents($remoteRevisionLocalFilePath));
		} else {
			$remoteRevision = NULL;
		}
		$git->setDeployFile($deploy);
		$servers = $git->getServers();
		$serverOptions = reset($servers);
		$files = $git->getFilesToUpload($remoteRevision, $revision, $serverOptions);
		$git->output("Update from $remoteRevision to $revision");
		if (count($files['upload']) === 0 && count($files['delete']) === 0) {
			$git->output('No files to upload or delete.');
		} else {
			if (count($files['upload']) > 0) {
				$git->output("Files to upload:");
				foreach ($files['upload'] as $fileToUpload) {
					$git->output($fileToUpload);
				}
			}

			if (count($files['delete']) > 0) {
				$git->output("Files to delete:");
				foreach ($files['delete'] as $fileToDelete) {
					$git->output($fileToDelete);
				}
			}
		}
	}
} catch (Exception $e) {
	echo $e->getMessage() . "\r\n";
	exit(1);
}

class Terra_Git
{
	/** server directory of the staged releases, relative to `path` / `sshPath` */
	const STAGE_DIR = '.git-deploy';

	protected array $filesToIgnore = [
		'git-deploy',
		'git-deploy-agent.php',
		'.gitignore',
	];
	protected bool $print = true;
	protected string $logBuffer = '';
	protected string $logFile = 'git-deploy.log.txt';
	protected array $submodules = [];
	protected array $servers = [];
	protected array $pathsThatExist = [];
	protected string $currentPath = '';


	function __construct()
	{
		# Check if there are any submodules in the git repository.

		$command = "git submodule status";

		$output = [];
		exec($command, $output);

		foreach ($output as $line) {
			$line = preg_split('/\s+/', trim($line));
			if (isset($line[1])) {
				$this->submodules[] = $line[1];
			}
		}
	}


	function setDeployFile(string $deploy): void
	{
		if (!@file_exists($deploy)) {
			throw new Exception("File '$deploy' does not exist.");
		} else {
			$servers = parse_ini_file($deploy, true);
			if (!$servers) {
				throw new Exception("File '$deploy' is not a valid .ini file.");
			} else {
				$this->addServers($servers, basename($deploy, '.ini'));
			}
		}
		$this->ignoreFile($deploy);
	}


	function getServers(): array
	{
		return $this->servers;
	}


	function addServers(array $servers, string $env): void
	{
		foreach ($servers as $uri => $options) {

			if (substr($uri, 0, 6) === 'ftp://' || substr($uri, 0, 7) === 'ftps://' || substr($uri, 0, 7) === 'sftp://') {
				$options = array_merge($options, parse_url($uri));
			}

			# Throw in some default values, in case they're not set.
			$options = array_merge([
				'scheme' => 'ftp',
				'skip' => false,
				'host' => '',
				'user' => '',
				'pass' => '',
				'port' => 21,
				'path' => '/',
				'passive' => true,
				'maintenanceMode' => true,
				'indexPath' => 'web/index.php',
				'maintenancePath' => 'web/.maintenance.php',
				'gitDeployDirectory' => '',
				'clean_directories' => [],
				'after' => [],
				'file_permissions' => [],
				'substitutions' => [],
				'env' => $env,
				'uploadComposerLibs' => false,
				// SFTP key-based auth: path to a private key file. When set, `pass` is
				// treated as the key passphrase (empty = unencrypted key).
				'privateKeyPath' => '',
				// Working directory for server-side SSH commands (composer install).
				// FTP `path` may be chroot-relative; this is the absolute filesystem path.
				// Falls back to `path` when empty.
				'sshPath' => '',
				// Server-side composer command. Falls back to a sane default when empty.
				'composerCommand' => '',
				// Staged deploy (sftp only): upload into `.git-deploy/<rev>/files/`, verify on the server, run
				// `beforeSwitch` commands, then copy the files into the live tree in one server-side step.
				'stagedDeploy' => false,
				// Commands run over SSH (in sshPath) after the verified upload, before the switch; a non-zero exit
				// aborts the deploy with the live tree untouched. `{staged}` = absolute path of the staged files.
				'beforeSwitch' => [],
				// How to run PHP on the server for the staged-deploy agent. The default runs it as the SFTP user, with
				// the same rights as a plain upload; e.g. "sudo -u www-data php" when only the web server user can write.
				'phpCommand' => 'php',
				// Number of staged releases kept on the server for --rollback.
				'stagedKeep' => 5,
			], $options);

			if ($options['stagedDeploy'] && $options['scheme'] !== 'sftp') {
				throw new Exception("stagedDeploy needs scheme = sftp - the server-side steps run over SSH ($uri).");
			}

			global $forceMaintenance;
			if ($forceMaintenance) {
				$options['maintenanceMode'] = true;
			}

			if ($options['scheme'] === 'sftp' && $options['port'] == 21) {
				$options['port'] = 22;
			}

			if ($options['skip']) {
				continue;
			} else {
				$this->servers[$uri] = $options;
			}
		}
	}


	function ignoreFile(string $file): void
	{
		$this->filesToIgnore[] = $file;
	}


	/**
	 * Filter out ignored files & files not placed inside gitDeployDirectory if not empty.
	 * @param array $files
	 * @param string $gitDeployDir
	 * @return array
	 */
	function filterFiles(array $files, string $gitDeployDir): array
	{
		foreach ($files as $key => $file) {
			if (
				in_array($file, $this->filesToIgnore)
				// exclude all but gitDeployDirectory files
				|| (!empty($gitDeployDir) && strpos($file, $gitDeployDir) !== 0)
			) {
				unset($files[$key]);
			}
		}
		return $files;
	}


	function getFilesToUpload(?string $oldRevision = null, string $newRevision = 'HEAD', array $serverOptions = []): array
	{
		$gitDeployDir = (string)($serverOptions['gitDeployDirectory'] ?? '');

		# Get the list of files to update.
		if (!empty($oldRevision)) {
			$command = "git diff --name-status {$oldRevision} {$newRevision}";
		} else {
			$command = "git ls-files";
		}

		$output = [];
		exec($command, $output);

		$filesToUpload = [];
		$filesToDelete = [];

		if (!empty($oldRevision)) {
			foreach ($output as $line) {
				$path = trim(substr($line, 1, strlen($line)));
				if ($line[0] == 'A' or $line[0] == 'C' or $line[0] == 'M') {
					$filesToUpload[] = $path;
				} elseif ($line[0] == 'D') {
					$filesToDelete[] = $path;
					// rename, score 100
				} elseif ($line[0] == 'R') {
					$chunks = explode("\t", $line);
					$filesToDelete[] = $chunks[1];
					$filesToUpload[] = $chunks[2];
				} else {
					throw new Exception("Unknown git-diff status: {$line[0]}");
				}
			}
		} else {
			$filesToUpload = $output;
		}

		$filesToUpload = $this->filterFiles($filesToUpload, $gitDeployDir);
		$filesToDelete = $this->filterFiles($filesToDelete, $gitDeployDir);

		$substitutions = $serverOptions['substitutions'];
		if ($substitutions) {
			$filesToUploadRemotePaths = preg_replace(array_keys($substitutions), array_values($substitutions), $filesToUpload);
			$filesToDeleteRemotePaths = preg_replace(array_keys($substitutions), array_values($substitutions), $filesToDelete);
		} else {
			$filesToUploadRemotePaths = $filesToUpload;
			$filesToDeleteRemotePaths = $filesToDelete;
		}

		return [
			'upload' => array_combine($filesToUpload, $filesToUploadRemotePaths),
			'delete' => array_combine($filesToDelete, $filesToDeleteRemotePaths),
		];
	}


	function output(string $message): void
	{
		if ($this->print) {
			echo $message . "\r\n";
		} else {
			$this->logBuffer .= $message . "\r\n";
		}
	}


	/**
	 * Regenerates the local Composer autoloader, without dev packages when $noDev is set. Aborts the deploy when
	 * Composer fails - uploading a stale autoloader is what the caller guards against.
	 */
	function dumpAutoload(bool $noDev): void
	{
		$command = 'composer dump-autoload --optimize --no-scripts --working-dir=' . escapeshellarg(__DIR__)
			. ($noDev ? ' --no-dev' : '') . ' 2>&1';
		$output = [];
		exec($command, $output, $exitCode);
		if ($exitCode !== 0) {
			$this->output("DEPLOY FAILED: `$command` exited with $exitCode:\n" . implode("\n", $output));
			exit(1);
		}
		$this->output($noDev
			? 'Composer: autoloader dumped without dev packages for the upload.'
			: 'Composer: local autoloader with dev packages restored.');
	}


	function __destruct() {}


	function revert(): void
	{
		foreach ($this->servers as $server) {
			$this->deployGit($server, 'HEAD', true);
		}
	}


	function deploy(string $revision = 'HEAD'): void
	{
		foreach ($this->servers as $server) {
			$this->deployGit($server, $revision);
		}
	}


	function mkdir($connection, string $file, string $scheme): bool
	{
		$dir = explode('/', str_replace('\\', '/', dirname($file)));
		$path = '';

		for ($i = 0; $i < count($dir); $i++) {
			if ($dir[$i] === '' || $dir[$i] === '.') continue;
			$path .= $dir[$i] . '/';

			if (!isset($this->pathsThatExist[$path])) {
				if ($scheme === 'sftp') {
					if (!$connection->file_exists($path)) {
						if (!$connection->mkdir($path)) {
							// Double check if it was created by another process
							if (!$connection->is_dir($path)) {
								$this->output("Failed to create '$path'.");
								return false;
							}
						} else {
							// the SFTP umask strips the group-write bit; the web server user (group) writes here too -
							// composer, runtime caches, a staged-deploy agent run as it. Keeps the parent's setgid bit.
							$connection->chmod(0775 | ((int) $connection->fileperms(dirname($path)) & 02000), $path);
							$this->output("Created directory '$path'.");
						}
					}
					$this->pathsThatExist[$path] = true;
				} else {
					$origin = $this->currentPath;
					if (!@ftp_chdir($connection, $path)) {
						if (!@ftp_mkdir($connection, $path)) {
							// Check if it was created by another process or already exists
							if (!@ftp_chdir($connection, $path)) {
								$this->output("Failed to create '$path'.");
								return false;
							}
						} else {
							$this->output("Created directory '$path'.");
						}
					}
					$this->pathsThatExist[$path] = true;
					@ftp_chdir($connection, $origin);
				}
			}
		}

		return true;
	}


	function deployGit(array $server, string $revision = 'HEAD', bool $revert = false): void
	{

		// a full hash also for `-r <branch>`: it names the staged release and is written to REVISION
		$output = [];
		$commit = exec('git rev-parse --verify "' . $revision . '^{commit}"', $output, $exitCode);
		if ($exitCode !== 0 || $commit === false) {
			throw new Exception("Unknown revision '$revision'.");
		}
		$revision = $commit;

		# Let's make sure the $path ends with a slash.

		if (substr($server['path'], -1) !== '/') {
			$server['path'] = $server['path'] . '/';
		}

		# Okay, let's connect to the server.
		$connection = $this->connect($server);

		$this->output(("----------------------------"));
		$this->output("Connected to {$server['host']}{$server['path']} via " . strtoupper($server['scheme']));
		$this->output("----------------------------");

		# Now that we're logged in to the server, let's get the remote revision.

		$remoteRevision = $this->getRemoteRevisionContent($connection, 'REVISION', $server['scheme']);
		$previousRevision = $this->getRemoteRevisionContent($connection, 'PREVIOUS_REVISION', $server['scheme']);
		$isFirstTimeDeploy = $remoteRevision === NULL;
		// clean working directory is required for first-time deploy to avoid massive file renaming while uploading (see below)
		if ($isFirstTimeDeploy) {
			$output = [];
			exec('git status --porcelain', $output);
			if (!empty($output)) {
				$this->output('First-time deployment requires clean working directory! Clean it please and retry!');
				exit;
			}
		}

		if ($revert) {
			if (!isset($previousRevision)) {
				throw new Exception("Could not find previous revision in {$server['host']}, which means that reverting is not possible.");
			}

			$this->output("WARNING: Composer-managed libraries will NOT be reverted!");

			# Set revision to PREVIOUS_REVISION, for reverting.
			$revision = $previousRevision;
			if ($remoteRevision != $revision) {
				$this->output("Reverting from " . substr($remoteRevision, 0, 6) . " to " . substr($revision, 0, 6) . ".");
				$this->output("----------------------------");
			}
		} else {
			if ($remoteRevision && $remoteRevision != $revision) {
				$this->output("Deploying update from " . substr($remoteRevision, 0, 6) . " to " . substr($revision, 0, 6) . ".");
				$this->output("----------------------------");
			}
		}

		$files = $this->getFilesToUpload($remoteRevision, $revision, $server);
		$filesToUpload = $files['upload'];
		$filesToDelete = $files['delete'];
		unset($files);

		// Set true when an SFTP deploy detects changed composer packages. The actual
		// server-side `composer install` runs after the upload loop (see below) so it sees
		// the freshly-uploaded composer.lock instead of the stale one on the server.
		$runComposerInstallOnServer = false;

		$composerLockPath = __DIR__ . '/composer.lock';
		$envComposerLockPath = GIT_DEPLOY_DIR . '/' . $server['env'] . '.composer.lock';

		if ($isFirstTimeDeploy) {

			// paths are relative to root
			$firstTimeDeployFiles = [
				'app/config/user_pass.neon' => 'app/config/user_pass.neon',
			];

			if ($server['uploadComposerLibs']) {
				// upload composer-managed packages
				$dirs = ['vendor/'];
				foreach ($dirs as $relPath) {
					$absPath = __DIR__ . '/' . $relPath;
					if (is_dir($absPath)) {
						foreach (get_recursive_file_list($absPath, $relPath) as $f) {
							// skip git-tracked vendor/others directory
							if (strpos($f, 'vendor/others/') !== 0) {
								$firstTimeDeployFiles[$f] = $f;
							}
						}
					}
				}
			}

			$filesToUpload = array_merge($filesToUpload, $firstTimeDeployFiles);
		} else {
			// check if composer-managed libs have changed
			// we handle only new/updated libraries (to upload), not removed ones (to remove)
			$composerChangedFiles = [];
			$composerLockFileName = $server['gitDeployDirectory'] . 'composer.lock';
			if (isset($filesToUpload[$composerLockFileName])) {
				if (!file_exists($envComposerLockPath)) {
					throw new Exception('Env-specific composer.lock file is missing -> cannot update composer-managed files');
				}
				if (!file_exists($composerLockPath)) {
					throw new Exception('`composer.lock` file is missing -> cannot update composer-managed files');
				}

				// load versioned composer.lock
				$command = "git show $revision:$composerLockFileName";
				$output = [];
				exec($command, $output);
				$localComposerLockJson = json_decode(join('', $output));

				$workingLocalComposerLockJson = json_decode(file_get_contents($composerLockPath));
				if ($workingLocalComposerLockJson->{'content-hash'} !== $localComposerLockJson->{'content-hash'}) {
					$this->output('There are uncommitted changes in `composer.lock` file so it is not safe to deploy now (we could upload packages with other versions than those in composer.lock'
						. "\nPlease commit it and try again.");
					exit;
				}

				$deployedComposerLockJson = json_decode(file_get_contents($envComposerLockPath));
				$localPackages = $localComposerLockJson->packages;
				$deployedPackages = $deployedComposerLockJson->packages;

				// content-hash is derived from composer.json requirements only, so a
				// `composer update <package>` that bumps a git reference within the
				// allowed version range leaves content-hash intact while the resolved
				// package actually changed. Detect changes by comparing version AND
				// source.reference for every package.
				$deployedByName = [];
				foreach ($deployedPackages as $p) {
					$deployedByName[$p->name] = $p;
				}
				$packageRef = static function ($p): ?string {
					return $p->source->reference ?? $p->dist->reference ?? null;
				};
				$packagesChanged = false;
				foreach ($localPackages as $p) {
					$deployed = $deployedByName[$p->name] ?? null;
					if (
						$deployed === null
						|| $deployed->version !== $p->version
						|| $packageRef($deployed) !== $packageRef($p)
					) {
						$packagesChanged = true;
						break;
					}
				}
				if (!$packagesChanged && count((array)$deployedPackages) !== count((array)$localPackages)) {
					$packagesChanged = true;
				}

				if ($packagesChanged) {

					if (!$server['uploadComposerLibs']) {
						if ($server['scheme'] === 'sftp') {
							// Defer the actual `composer install` until after the upload loop;
							// running it here would execute against the OLD composer.lock still on
							// the server (the new lock is uploaded later in this function).
							$runComposerInstallOnServer = true;
						} else {
							$this->output('A change in composer managed libraries detected..Please run `composer install` on server.');
						}
					} else {
						/**
						 * Has package version or source reference changed?
						 * @param string $name package name
						 * @param string $version current package version
						 * @param string|null $reference current package source/dist reference
						 * @param string $deployedVersion deployed package version to be set
						 * @return bool
						 */
						$hasPackageChanged = function ($name, $version, $reference, &$deployedVersion = NULL) use ($deployedByName, $packageRef) {
							$deployed = $deployedByName[$name] ?? null;
							if ($deployed === null) {
								return true;
							}
							$deployedVersion = (string)$deployed->version;
							return $deployed->version !== $version
								|| $packageRef($deployed) !== $reference;
						};

						$composerLibChanged = false;
						foreach ($localComposerLockJson->packages as $p) {
							$deployedVersion = NULL;
							if ($hasPackageChanged($p->name, $p->version, $packageRef($p), $deployedVersion)) {
								$composerLibChanged = true;
								addFilesFromDirectory('vendor/' . $p->name . '/', $composerChangedFiles);

								$this->output("Composer: <$p->name> changed from <$deployedVersion> to <$p->version>");
							}
						}

						// if changed, copy composer/ & autoload.php
						if ($composerLibChanged) {
							// The local vendor/ is a dev install: its autoloader requires the bootstrap files of dev
							// packages (phpstan, rector, ...), which are never uploaded, so uploading it as is makes
							// every request on the server fatal. Upload one dumped without dev packages and restore
							// the dev one afterwards, also when the deploy exits early. This script keeps the class
							// map it loaded at start, so rewriting the files does not affect it.
							$this->dumpAutoload(true);
							register_shutdown_function(function (): void {
								$this->dumpAutoload(false);
							});
							addFilesFromDirectory('vendor/composer/', $composerChangedFiles);
							$composerChangedFiles['vendor/autoload.php'] = 'vendor/autoload.php';
						}

						$filesToUpload = array_merge($filesToUpload, $composerChangedFiles);
					}
				} else {
					$this->output('No change in composer managed libraries detected..');
				}
			}
		}

		$staged = $server['stagedDeploy'] && (count($filesToUpload) > 0 || count($filesToDelete) > 0);
		if ($staged && $isFirstTimeDeploy) {
			$this->output('First-time deploy: uploading straight into the live tree, stagedDeploy applies from the next deploy.');
			$staged = false;
		}
		if ($staged) {
			// the live tree stays untouched until switchRelease()
			$this->stageRelease($connection, $server, $revision, $remoteRevision, $filesToUpload, $filesToDelete, $composerChangedFiles ?? []);
		}

		$maintenanceModeTurnedOn = false;
		$indexPath = $server['indexPath'];
		$maintenancePath = $server['maintenancePath'];
		$tmpIndexPath = $indexPath . '.tmp';
		$useMaintenance = $server['maintenanceMode'] && !$isFirstTimeDeploy && (count($filesToUpload) > 0 or count($filesToDelete) > 0);
		$turnOnMaintenance = function () use (&$maintenanceModeTurnedOn, $server, $connection, $indexPath, $maintenancePath, $tmpIndexPath): void {
			if ($server['scheme'] === 'sftp') {
				$connection->rename($indexPath, $tmpIndexPath);
				$connection->rename($maintenancePath, $indexPath);
			} else {
				ftp_rename($connection, $indexPath, $tmpIndexPath);
				ftp_rename($connection, $maintenancePath, $indexPath);
			}
			$this->output('Maintenance mode turned ON');
			$maintenanceModeTurnedOn = true;
		};

		// the site stays down until the after hooks (migrations, cache clean) finish - new files with the old DI
		// container or the old DB schema fail; the hooks are separate scripts, not served through index.php
		$turnOffMaintenance = function () use (&$maintenanceModeTurnedOn, $server, &$connection, $indexPath, $maintenancePath, $tmpIndexPath): void {
			if (!$maintenanceModeTurnedOn) {
				return;
			}
			// a long after hook (migrations) can outlive the idle connection
			if ($server['scheme'] === 'sftp' ? !$connection->isConnected() : @ftp_pwd($connection) === false) {
				$this->output('Reconnecting to turn the maintenance mode off');
				$connection = $this->connect($server);
			}
			if ($server['scheme'] === 'sftp') {
				$connection->rename($indexPath, $maintenancePath);
				$connection->rename($tmpIndexPath, $indexPath);
			} else {
				ftp_rename($connection, $indexPath, $maintenancePath);
				ftp_rename($connection, $tmpIndexPath, $indexPath);
			}
			$this->output("Maintenance mode turned OFF");
		};

		// a staged deploy keeps the old site up through its beforeSwitch migrations - except with --maintenance, which
		// is there for migrations the old code cannot run against (dropped or renamed tables and columns)
		global $forceMaintenance;
		if ($useMaintenance && (!$staged || $forceMaintenance)) {
			$turnOnMaintenance();
		}

		if ($staged) {
			if (!$this->runBeforeSwitch($connection, $server, $revision)) {
				$turnOffMaintenance();
				exit(1);
			}
			if ($useMaintenance && !$maintenanceModeTurnedOn) {
				$turnOnMaintenance();
			}
			if (!$this->switchRelease($connection, $server, $revision, $maintenanceModeTurnedOn ? [$indexPath => $tmpIndexPath] : [])) {
				$turnOffMaintenance();
				$this->output('Switch failed - aborting.');
				exit(1);
			}
		} else {
			// most of the time $localFile === $remoteFile - $remoteFile just defines path where $localFile gets uploaded
			foreach ($filesToUpload as $localFile => $remoteFile) {
				// the real index.php is parked under its .tmp name while the maintenance page serves - a new version goes there too
				if ($maintenanceModeTurnedOn && $remoteFile === $indexPath) {
					$remoteFile = $tmpIndexPath;
				}
				// first time we upload files as they are (working directory is clean)
				// same for composerChangedFiles as they are not tracked with git
				if ($isFirstTimeDeploy || isset($composerChangedFiles[$localFile])) {
					$this->uploadFile($connection, $server['scheme'], $localFile, $remoteFile, $localFile);
				} else {
					// other times we upload tmp file with content of $revision
					$tmpFileToUpload = GIT_DEPLOY_DIR . '/tmpFileToUpload';
					$this->exportRevisionFile($revision, $localFile, $tmpFileToUpload);
					$this->uploadFile($connection, $server['scheme'], $tmpFileToUpload, $remoteFile, $localFile);
					unlink($tmpFileToUpload);
				}
			}

			foreach ($filesToDelete as $file) {
				if ($server['scheme'] === 'sftp') {
					$connection->delete($file);
				} else {
					@ftp_delete($connection, $file);
				}
				$this->output("Deleted {$file}");
			}
		}

		// Now that composer.json + composer.lock are in the live tree, run the deferred server-side
		// `composer install`. Done before REVISION is written (a failed install aborts without
		// marking the deploy successful) and before the `after` hook (after.php loads the app
		// + vendor, so it must see the new packages).
		if ($runComposerInstallOnServer) {
			$this->runComposerInstall($connection, $server);
		}

		if (!empty($server['clean_directories'])) {
			foreach ($server['clean_directories'] as $dir) {
				$this->rmdirr($connection, $dir, $server['scheme']);
				$this->output("Emptied {$dir}");
			}
		} else {
			$this->output("\r\n*** Don't forget to empty cache if needed! ***\r\n");
		}

		if (count($filesToUpload) > 0 or count($filesToDelete) > 0) {
			$this->output("----------------------------");
			$temp = tempnam(sys_get_temp_dir(), 'gitRevision');
			file_put_contents($temp, $revision);
			if ($server['scheme'] === 'sftp') {
				$connection->put('REVISION', $temp, SFTP::SOURCE_LOCAL_FILE);
			} else {
				ftp_put($connection, 'REVISION', $temp, FTP_ASCII);
			}
			unlink($temp);
			$this->output("Uploaded REVISION file.");

			file_put_contents(getRemoteRevisionLocalFilepath(), $revision);
			$this->output("Stored local REMOTE_REVISION file.");

			# Upload file containing the current revision, for reverting when necessary.
			# But, only if the revision we're deploying is different from the one currently deployed.
			if ($remoteRevision != $revision) {
				$temp = tempnam(sys_get_temp_dir(), 'gitRevision');
				file_put_contents($temp, $remoteRevision);
				if ($server['scheme'] === 'sftp') {
					$connection->put('PREVIOUS_REVISION', $temp, SFTP::SOURCE_LOCAL_FILE);
				} else {
					ftp_put($connection, 'PREVIOUS_REVISION', $temp, FTP_ASCII);
				}
				unlink($temp);
				$this->output("Uploaded PREVIOUS_REVISION file.");
			}

			$this->storeComposerLockSnapshot($server, $revision);
		} else {
			$this->output("No files to upload.");
		}

		if (!empty($server['file_permissions'])) {
			$this->setFilePermissions($connection, $server['file_permissions'], $server['scheme']);
		}

		if (!$this->runAfterHooks($server)) {
			$turnOffMaintenance();
			$this->output('After-hook reported `DEPLOY FAILED` in stream body - aborting.');
			exit(1);
		}
		$turnOffMaintenance();

		if ($staged) {
			// a long after hook (migrations) can outlive the idle connection
			if (!$connection->isConnected()) {
				$connection = $this->connect($server);
			}
			[$cleanupOutput] = $this->sshExec($connection, $server, $this->agentCommand($server) . ' cleanup ' . (int) $server['stagedKeep'] . ' ' . self::shellQuote($revision));
			$this->output(rtrim($cleanupOutput));
		}

		$this->output("----------------------------");
		$this->output("Finished working on {$server['host']}{$server['path']}");
		$this->output("----------------------------");

		if ($server['scheme'] === 'sftp') {
			$connection->disconnect();
		} else {
			@ftp_close($connection);
		}
	}


	/**
	 * Restores the files the last staged deploy overwrote or deleted (see git-deploy-agent.php) and runs the after hooks.
	 * The database is not rolled back - migrations have to stay compatible with the previous code.
	 */
	function rollback(): void
	{
		foreach ($this->servers as $server) {
			if (!$server['stagedDeploy']) {
				throw new Exception('--rollback needs stagedDeploy = true: only staged deploys keep a backup on the server.');
			}
			$this->rollbackServer($server);
		}
	}


	private function rollbackServer(array $server): void
	{
		$connection = $this->connect($server);
		$revision = $this->getRemoteRevisionContent($connection, 'REVISION', 'sftp');
		// the agent's record of the live files - REVISION lags behind when a deploy stopped after its switch (composer
		// install); trusted only when its release continues from REVISION, a later plain deploy leaves it stale
		$current = $connection->get(self::STAGE_DIR . '/current');
		$current = is_string($current) ? trim($current) : '';
		if ($current !== '' && $current !== $revision && ($this->readStagedManifest($connection, $current)['from'] ?? null) === $revision) {
			$revision = $current;
		}
		$manifest = $revision !== null ? $this->readStagedManifest($connection, $revision) : null;
		if (empty($manifest['from'])) {
			throw new Exception("The server keeps no staged release of the deployed revision '$revision' to roll back.");
		}
		$from = (string) $manifest['from'];
		$this->output("Rolling back {$server['host']}{$server['path']} from " . substr($revision, 0, 9) . ' to ' . substr($from, 0, 9) . '.');

		// a deploy that stopped after its switch left the maintenance page up, the real index.php parked under .tmp;
		// otherwise it goes up as in a deploy - the restored files fail with the new DI container until the after hooks
		$indexPath = $server['indexPath'];
		$maintenancePath = $server['maintenancePath'];
		$tmpIndexPath = $indexPath . '.tmp';
		$maintenanceLeftUp = $connection->file_exists($tmpIndexPath);
		$maintenanceOn = $maintenanceLeftUp;
		if (!$maintenanceOn && $server['maintenanceMode']) {
			$connection->rename($indexPath, $tmpIndexPath);
			$connection->rename($maintenancePath, $indexPath);
			$maintenanceOn = true;
			$this->output('Maintenance mode turned ON');
		}
		$turnOffMaintenance = function () use ($maintenanceOn, $server, &$connection, $indexPath, $maintenancePath, $tmpIndexPath): void {
			if (!$maintenanceOn) {
				return;
			}
			if (!$connection->isConnected()) {
				$connection = $this->connect($server);
			}
			$connection->rename($indexPath, $maintenancePath);
			$connection->rename($tmpIndexPath, $indexPath);
			$this->output('Maintenance mode turned OFF');
		};

		$command = $this->agentCommand($server) . ' rollback ' . self::shellQuote($revision);
		if ($maintenanceOn) {
			$command .= ' ' . self::shellQuote("--parked=$indexPath=$tmpIndexPath");
		}
		[$agentOutput, $exitCode] = $this->sshExec($connection, $server, $command);
		$this->output(rtrim($agentOutput));
		if ($exitCode !== 0) {
			// a page the stopped deploy left up stays - its live tree still is not what the old code needs
			if (!$maintenanceLeftUp) {
				$turnOffMaintenance();
			}
			$this->output('Rollback failed - aborting.');
			exit(1);
		}

		$this->writeRemoteFile($connection, 'REVISION', $from);
		$this->writeRemoteFile($connection, 'PREVIOUS_REVISION', $revision);
		file_put_contents(getRemoteRevisionLocalFilepath(), $from);
		$this->storeComposerLockSnapshot($server, $from);
		$this->output('REVISION set back to ' . substr($from, 0, 9) . '.');

		// the restored composer.lock describes the packages the old code needs
		if (isset($manifest['upload']['composer.lock'])) {
			$this->runComposerInstall($connection, $server);
		}
		if (!$this->runAfterHooks($server)) {
			$turnOffMaintenance();
			$this->output('After-hook reported `DEPLOY FAILED` in stream body - aborting.');
			exit(1);
		}
		$turnOffMaintenance();
		$this->output("Finished rolling back {$server['host']}{$server['path']}");
		$connection->disconnect();
	}


	/**
	 * @return array<string, mixed>|null the manifest of a release kept in STAGE_DIR, null when there is none
	 */
	private function readStagedManifest($connection, string $revision): ?array
	{
		$json = $connection->get(self::STAGE_DIR . "/$revision/manifest.json");
		$manifest = is_string($json) ? json_decode($json, true) : null;
		return is_array($manifest) ? $manifest : null;
	}


	/**
	 * Uploads the release into STAGE_DIR/<rev>/files/ with its manifest and has the server verify it: only missing or
	 * corrupt files are (re)uploaded, so a repeated deploy of an interrupted upload sends just the rest. Exits the deploy
	 * on any failure - the live tree is not touched before switchRelease().
	 * @param array<string, string> $filesToUpload local path => remote path
	 * @param array<string, string> $filesToDelete local path => remote path
	 * @param array<string, string> $untrackedFiles files uploaded from the working tree as they are (composer libs)
	 */
	private function stageRelease($connection, array $server, string $revision, ?string $remoteRevision, array $filesToUpload, array $filesToDelete, array $untrackedFiles): void
	{
		$releaseDir = self::STAGE_DIR . '/' . $revision;
		$localDir = GIT_DEPLOY_DIR . '/stage-' . $server['env'];
		$this->removeLocalDir($localDir);

		$localFiles = []; // remote path => local file holding its content
		$manifestFiles = [];
		foreach ($filesToUpload as $localFile => $remoteFile) {
			if (isset($untrackedFiles[$localFile])) {
				$localPath = $localFile;
			} else {
				$localPath = $localDir . '/' . $remoteFile;
				$this->exportRevisionFile($revision, $localFile, $localPath);
			}
			$localFiles[$remoteFile] = $localPath;
			$manifestFiles[$remoteFile] = ['size' => filesize($localPath), 'sha1' => sha1_file($localPath)];
		}
		$manifest = [
			'from' => $remoteRevision,
			'to' => $revision,
			'created' => date('c'),
			'upload' => $manifestFiles,
			'delete' => array_values($filesToDelete),
		];
		$this->writeRemoteFile($connection, self::STAGE_DIR . '/agent.php', file_get_contents(__DIR__ . '/git-deploy-agent.php'));
		$this->writeRemoteFile($connection, $releaseDir . '/manifest.json', json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));

		$verifyCommand = $this->agentCommand($server) . ' verify ' . self::shellQuote($revision);
		for ($round = 1; ; $round++) {
			[$verifyOutput, $exitCode] = $this->sshExec($connection, $server, $verifyCommand);
			$lines = preg_split('/\R/', trim($verifyOutput));
			$result = $exitCode === 0 ? json_decode((string) end($lines), true) : null;
			if (!is_array($result) || !isset($result['bad'], $result['unwritable']) || array_diff($result['bad'], array_keys($localFiles)) !== []) {
				$this->output("DEPLOY FAILED: the server could not verify the staged release:\n" . $verifyOutput);
				exit(1);
			}
			if ($result['unwritable'] !== []) {
				$this->output("DEPLOY FAILED: the server-side user cannot write into these live directories (make them group-writable):\n  "
					. implode("\n  ", $result['unwritable']));
				exit(1);
			}
			$bad = $result['bad'];
			if ($bad === []) {
				break;
			}
			if ($round > 3) {
				$this->output("DEPLOY FAILED: still missing or corrupt after 3 uploads: " . implode(', ', $bad));
				exit(1);
			}
			$this->output($round === 1
				? sprintf('Uploading %d of %d file(s) to %s/', count($bad), count($localFiles), $releaseDir)
				: sprintf('Verification found %d missing or corrupt file(s), uploading them again', count($bad)));
			foreach ($bad as $remoteFile) {
				$this->uploadFile($connection, 'sftp', $localFiles[$remoteFile], $releaseDir . '/files/' . $remoteFile, $remoteFile);
			}
		}
		$this->output(sprintf('Staged release verified: %d file(s) to copy in, %d to delete.', count($localFiles), count($filesToDelete)));
		$this->removeLocalDir($localDir);
	}


	/**
	 * Runs the beforeSwitch commands of a verified staged release, stopping at the first non-zero exit.
	 * @return bool false when a command failed - the live tree is untouched
	 */
	private function runBeforeSwitch($connection, array $server, string $revision): bool
	{
		foreach ($server['beforeSwitch'] as $command) {
			$command = str_replace('{staged}', $this->sshCwd($server) . '/' . self::STAGE_DIR . '/' . $revision . '/files', $command);
			$this->output("Before switch: $command");
			[$commandOutput, $exitCode] = $this->sshExec($connection, $server, $command);
			if (trim($commandOutput) !== '') {
				$this->output('  ' . str_replace("\n", "\n  ", rtrim($commandOutput)));
			}
			if ($exitCode !== 0) {
				$this->output("DEPLOY FAILED: the before-switch command exited with $exitCode, the live tree was not touched.");
				return false;
			}
		}
		return true;
	}


	/**
	 * Has the server back up the live files and move the staged release in.
	 * @param array<string, string> $parked manifest path => live path currently holding it (index.php under maintenance)
	 * @return bool false when the switch failed - the agent has then restored the old files
	 */
	private function switchRelease($connection, array $server, string $revision, array $parked): bool
	{
		$command = $this->agentCommand($server) . ' switch ' . self::shellQuote($revision);
		foreach ($parked as $path => $target) {
			$command .= ' ' . self::shellQuote("--parked=$path=$target");
		}
		[$agentOutput, $exitCode] = $this->sshExec($connection, $server, $command);
		$this->output(rtrim($agentOutput));
		return $exitCode === 0;
	}


	private function runComposerInstall($connection, array $server): void
	{
		$this->output('A change in composer managed libraries detected.. Running `composer install` on server via SSH.');
		$composerCmd = $server['composerCommand'] !== '' ? $server['composerCommand'] : 'composer install -o --no-dev';
		[$sshOutput, $exitCode] = $this->sshExec($connection, $server, $composerCmd);
		$this->output("SSH Output:\n" . $sshOutput);
		// `DEPLOY FAILED` marker aborts the run; the streamed deploy client also greps for
		// it. exec() exit status is the authoritative signal.
		if ($exitCode !== 0) {
			$this->output('DEPLOY FAILED: `composer install` exited with a non-zero status.');
			exit(1);
		}
		$this->output('`composer install` command has been executed.');
	}


	/**
	 * Calls the `after` URLs and streams their output.
	 * @return bool false when a hook reported `DEPLOY FAILED`
	 */
	private function runAfterHooks(array $server): bool
	{
		if (!empty($server['after'])) {
			foreach ($server['after'] as $url) {
				// Mask the ?token=... value in log output (deploy logs/transcripts get shared);
				// the request itself still carries the real token.
				$urlLog = preg_replace('/([?&]token=)[^&\s]+/', '$1***', $url);
				$this->output("$urlLog called, streaming response:");
				// Stream the response line by line so long-running deploy hooks (e.g. DB
				// migrations with heavy ALTERs) can finish before we exit and operators
				// see progress / errors immediately. We use cURL with a write callback
				// because PHP's built-in http:// stream wrapper buffers the entire
				// response body in userspace before fgets() sees anything -- not
				// suitable for streamed endpoints.
				// SSL peer verification is disabled -- the URL + token come from
				// deploy.ini which we trust, and the connection targets our own server.
				// Parse stream body for `DEPLOY FAILED` sentinel - streamed HTTP status
				// is locked at 200 once first flush commits headers, so the body marker
				// is the only reliable failure signal from after.php.
				$lineBuffer = '';
				$deployFailed = false;
				$self = $this;
				$writeCb = static function ($ch, string $chunk) use (&$lineBuffer, &$deployFailed, $self): int {
					$lineBuffer .= $chunk;
					while (($nl = strpos($lineBuffer, "\n")) !== false) {
						$line = substr($lineBuffer, 0, $nl);
						$lineBuffer = substr($lineBuffer, $nl + 1);
						$self->output('  ' . rtrim($line, "\r"));
						if (str_contains($line, 'DEPLOY FAILED')) {
							$deployFailed = true;
						}
					}
					return strlen($chunk);
				};
				$ch = curl_init($url);
				curl_setopt_array($ch, [
					CURLOPT_WRITEFUNCTION => $writeCb,
					CURLOPT_TIMEOUT => 0, // unlimited total time; long migrations may run for ages
					CURLOPT_CONNECTTIMEOUT => 30,
					CURLOPT_LOW_SPEED_LIMIT => 1, // abort if throughput drops below 1 B/s
					CURLOPT_LOW_SPEED_TIME => 2000, // ...for 33 min (effective idle timeout)
					CURLOPT_SSL_VERIFYPEER => false,
					CURLOPT_SSL_VERIFYHOST => 0,
					CURLOPT_FAILONERROR => false, // keep streaming body on 4xx/5xx
					CURLOPT_BUFFERSIZE => 128, // tiny receive buffer -> write callback fires often
				]);
				$ok = curl_exec($ch);
				if ($ok === false) {
					$this->output('  curl error: ' . curl_error($ch));
				}
				if ($lineBuffer !== '') {
					$this->output('  ' . rtrim($lineBuffer, "\r\n"));
					if (str_contains($lineBuffer, 'DEPLOY FAILED')) {
						$deployFailed = true;
					}
				}
				$this->output("$urlLog finished");
				if ($deployFailed) {
					return false;
				}
			}
		}
		return true;
	}


	/**
	 * Runs a shell command in the server's sshPath over the SFTP connection's SSH session.
	 * @return array{string, int|false} output (stderr included) and exit status
	 */
	private function sshExec($connection, array $server, string $command): array
	{
		// phpseclib gives up on exec() after 10 s without output and closes the channel, which kills
		// e.g. composer mid-install (packages removed, autoload not regenerated = fatal on every request)
		$connection->setTimeout(0);
		$output = $connection->exec('cd ' . self::shellQuote($this->sshCwd($server)) . ' && ' . $command . ' 2>&1');
		return [(string) $output, $connection->getExitStatus()];
	}


	private function sshCwd(array $server): string
	{
		return rtrim($server['sshPath'] !== '' ? $server['sshPath'] : $server['path'], '/');
	}


	private function agentCommand(array $server): string
	{
		return $server['phpCommand'] . ' ' . self::STAGE_DIR . '/agent.php';
	}


	/**
	 * POSIX shell quoting for commands run on the server - escapeshellarg() quotes for the LOCAL shell (cmd.exe on Windows).
	 */
	private static function shellQuote(string $arg): string
	{
		return "'" . str_replace("'", "'\\''", $arg) . "'";
	}


	/**
	 * Uploads a local file, retrying up to 10 times; ends the deploy when it keeps failing.
	 */
	private function uploadFile($connection, string $scheme, string $localPath, string $remoteFile, string $label): void
	{
		# Make sure the folder exists in the server.
		if (!$this->mkdir($connection, $remoteFile, $scheme)) {
			$this->output("A problem occurred while attempting to create a folder. Upload to this server cannot continue.");
			exit(1);
		}
		for ($attempt = 1; ; $attempt++) {
			if ($scheme === 'sftp') {
				$uploaded = $connection->put($remoteFile, $localPath, SFTP::SOURCE_LOCAL_FILE);
			} else {
				// Always use BINARY mode - ASCII mode corrupts large minified files (e.g. xlsx.full.min.js)
				$uploaded = @ftp_put($connection, $remoteFile, $localPath, FTP_BINARY);
			}
			if ($uploaded) {
				break;
			}
			if ($attempt === 10) {
				$this->output("Tried to upload $label 10 times, and failed 10 times. Something is wrong, so I'm going to stop executing now.");
				exit(1);
			}
			$this->output("Failed to upload {$label}. Retrying (attempt " . ($attempt + 1) . "/10)... ");
			usleep(500000);
		}
		$this->output("Uploaded {$label}");
	}


	/**
	 * Writes a string to a server file (sftp), creating its directory.
	 */
	private function writeRemoteFile($connection, string $remoteFile, string $content): void
	{
		if (!$this->mkdir($connection, $remoteFile, 'sftp') || !$connection->put($remoteFile, $content)) {
			throw new Exception("Cannot write $remoteFile on the server.");
		}
	}


	/**
	 * Writes the content of $file at $revision to $destination.
	 */
	private function exportRevisionFile(string $revision, string $file, string $destination): void
	{
		if (!is_dir(dirname($destination)) && !mkdir(dirname($destination), 0777, true)) {
			throw new Exception("Cannot create the directory of $destination.");
		}
		$output = [];
		exec("git show \"$revision:$file\" > \"$destination\"", $output, $exitCode);
		if ($exitCode !== 0) {
			throw new Exception("`git show $revision:$file` failed.");
		}
	}


	private function removeLocalDir(string $dir): void
	{
		if (!is_dir($dir)) {
			return;
		}
		$items = new RecursiveIteratorIterator(
			new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS),
			RecursiveIteratorIterator::CHILD_FIRST,
		);
		foreach ($items as $item) {
			$item->isDir() ? rmdir($item->getPathname()) : unlink($item->getPathname());
		}
		rmdir($dir);
	}


	/**
	 * Updates the env-specific composer.lock snapshot from the DEPLOYED revision, never from
	 * the working tree: a dirty local composer.lock (e.g. an uncommitted `composer update`)
	 * would otherwise poison the snapshot during an unrelated deploy, and the NEXT deploy
	 * that actually ships the lock would see "no packages changed" and skip the server-side
	 * `composer install`, leaving prod vendor stale.
	 */
	private function storeComposerLockSnapshot(array $server, string $revision): void
	{
		$output = [];
		exec("git show $revision:composer.lock", $output, $exitCode);
		if ($exitCode === 0 && $output !== []) {
			file_put_contents(GIT_DEPLOY_DIR . '/' . $server['env'] . '.composer.lock', join("\n", $output) . "\n");
		}
	}


	/**
	 * Open the SFTP / FTP connection to the server and change into its deploy path.
	 * @return SFTP|\FTP\Connection
	 */
	private function connect(array $server)
	{
		if ($server['scheme'] === 'sftp') {
			$connection = new SFTP($server['host'], $server['port']);
			if ($server['privateKeyPath'] !== '') {
				if (!@file_exists($server['privateKeyPath'])) {
					throw new Exception("Private key '{$server['privateKeyPath']}' does not exist.");
				}
				// `pass` doubles as the key passphrase; empty string = unencrypted key.
				$credential = PublicKeyLoader::load(
					file_get_contents($server['privateKeyPath']),
					$server['pass'] !== '' ? $server['pass'] : false,
				);
			} else {
				$credential = $server['pass'];
			}
			if (!$connection->login($server['user'], $credential)) {
				throw new Exception("Could not login to {$server['host']} via SFTP (Tried to login as {$server['user']}).");
			}
			if (!$connection->chdir($server['path'])) {
				throw new Exception("Could not change the SFTP directory to {$server['path']}.");
			}
			$this->currentPath = $server['path'];
		} else {
			if ($server['scheme'] === 'ftps') {
				$connection = @ftp_ssl_connect($server['host'], $server['port']);
			} else {
				$connection = @ftp_connect($server['host'], $server['port']);
			}

			if (!$connection) {
				throw new Exception("Could not connect to {$server['host']}.");
			} else {
				if (!ftp_login($connection, $server['user'], $server['pass'])) {
					throw new Exception("Could not login to {$server['host']} (Tried to login as {$server['user']}).");
				}

				ftp_pasv($connection, $server['passive']);
				ftp_set_option($connection, FTP_TIMEOUT_SEC, 300);

				if (ftp_chdir($connection, $server['path'])) {
					$this->currentPath = $server['path'];
				} else {
					throw new Exception("Could not change the FTP directory to {$server['path']}.");
				}
			}
		}
		return $connection;
	}


	/**
	 * Clean (and optionally remove) whole directory recursively
	 */
	function rmdirr($handle, string $path, string $scheme, bool $rmDir = false, int $level = 1): bool
	{
		if ($scheme === 'sftp') {
			$list = $handle->nlist($path);
			if ($list !== false) {
				foreach ($list as $value) {
					$baseName = basename($value);
					if ($baseName === '.' || $baseName === '..') continue;
					$fullPath = $path . '/' . $baseName;
					if ($handle->is_dir($fullPath)) {
						$this->rmdirr($handle, $fullPath, $scheme, true, $level + 1);
					} else {
						$handle->delete($fullPath);
					}
				}
			}
			if ($rmDir && $level > 1) {
				return $handle->rmdir($path);
			}
		} else {
			if (!@ftp_delete($handle, $path)) {
				$this->output("Cleaning: $path");
				$list = @ftp_nlist($handle, $path);
				if (!empty($list)) {
					foreach ($list as $value) {
						if (in_array(basename($value), ['.', '..'])) continue;
						$this->rmdirr($handle, $path . '/' . basename($value), $scheme, true, $level + 1);
					}
				}
			}
			if ($rmDir && $level > 1) {
				return @ftp_rmdir($handle, $path);
			}
		}

		return true;
	}


	/**
	 * Set 0777 file permissions for $items (create them if not present)
	 */
	function setFilePermissions($connection, array $items = [], string $scheme = 'ftp'): void
	{
		$mode = 0777;
		foreach ($items as $path) {
			if ($scheme === 'sftp') {
				if (!$connection->chmod($mode, $path)) {
					$connection->mkdir($path);
					$connection->chmod($mode, $path);
				}
			} else {
				if (!@ftp_chmod($connection, $mode, $path)) {
					ftp_mkdir($connection, $path);
					ftp_chmod($connection, $mode, $path);
				}
			}
		}
		$this->output('Permissions set.');
	}


	/**
	 * Get content of remote revision file.
	 */
	function getRemoteRevisionContent($connection, string $filename = 'REVISION', string $scheme = 'ftp'): ?string
	{
		if ($scheme === 'sftp') {
			$content = $connection->get($filename);
			return $content !== false ? trim($content) : null;
		} else {
			$tmpFile = tmpfile();
			$ret = NULL;
			if (@ftp_fget($connection, $tmpFile, $filename, FTP_ASCII)) {
				fseek($tmpFile, 0);
				$ret = trim(fread($tmpFile, 1024));
				fclose($tmpFile);
			}
			return $ret;
		}
	}
